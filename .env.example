# Copy to .env and adjust. The SDK requires a key even if the server ignores it.
OPENAI_BASE_URL=http://192.168.0.148:1234/v1   # self-hosted / OpenAI-compatible endpoint
OPENAI_API_KEY=local-no-auth                    # any non-empty value
AGENT_MODEL=ornith-1.5-9b                        # pin the model here

AGENT_TEMPERATURE=0.5
AGENT_TOP_P=1.0
AGENT_MAX_TOKENS=1024
AGENT_SEED=0

AGENT_MAX_ITERS=15
AGENT_CMD_TIMEOUT=60

AGENT_STREAM=1   # stream chat.completions (default; good for slow models)
AGENT_MOCK=0     # 1 = use the scripted MockLLM (no server needed)
